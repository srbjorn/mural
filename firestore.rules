rules_version = '2';
// Cole isto em Firebase → Firestore Database → Regras → Publicar.
// Só quem tem conta no projeto entra. Depois que vocês dois criarem as contas,
// desligue novas contas em Authentication → Configurações → Ações do usuário
// ("Ativar criação (inscrição)"), e ninguém mais consegue se cadastrar.
service cloud.firestore {
  match /databases/{database}/documents {
    match /itens/{id} {
      allow read, write: if request.auth != null;
    }
    match /pessoas/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
